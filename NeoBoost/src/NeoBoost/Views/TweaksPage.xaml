<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoBoost.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Réglages Windows" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="Uniquement des réglages qui ont un effet réel, avec ce qu'on peut honnêtement en attendre. Chacun se rétablit en un clic." />
                </StackPanel>
                <Button x:Name="RestoreAllButton" Grid.Column="1" VerticalAlignment="Center" Click="RestoreAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        <TextBlock Text="Tout rétablir" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="ResultBar" IsOpen="False" Margin="0,10,0,0" />
            <StackPanel x:Name="TweaksPanel" Spacing="6" Margin="0,10,0,0" />

            <TextBlock Text="Ce que NeoBoost ne fait pas, volontairement" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" LineHeight="22">
                    <Run Text="• Vider la mémoire vive : Windows la gère déjà, la vider oblige à tout recharger depuis le disque." /><LineBreak />
                    <Run Text="• Nettoyer le registre pour accélérer le PC : aucun gain mesurable, risque de casser des programmes." /><LineBreak />
                    <Run Text="• Désactiver des services Windows au hasard : gain négligeable, pannes difficiles à comprendre ensuite." /><LineBreak />
                    <Run Text="• « Booster » la connexion Internet ou défragmenter un SSD : sans effet, voire usant pour le SSD." />
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
