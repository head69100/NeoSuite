<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoDriver.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="6">
            <TextBlock Text="Paramètres" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <TextBlock Text="Apparence" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Thème" />
                        <TextBlock Text="Choisissez le thème de l'application" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" MinWidth="160" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Système" />
                        <ComboBoxItem Content="Clair" />
                        <ComboBoxItem Content="Sombre" />
                    </ComboBox>
                </Grid>
            </Border>


            <TextBlock Text="Analyse et installation" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE777;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Créer un point de restauration" />
                        <TextBlock Text="Avant chaque installation ou mise à jour de pilote" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RestorePointToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Toggle_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Analyser au démarrage" />
                        <TextBlock Text="Rechercher automatiquement les mises à jour à l'ouverture" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ScanOnStartupToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Toggle_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D7;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Pilotes signés uniquement" />
                        <TextBlock Text="Ignorer les pilotes sans signature numérique Microsoft" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SignedOnlyToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Toggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Text="À propos" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="40" Height="40" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NeoDriver" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
