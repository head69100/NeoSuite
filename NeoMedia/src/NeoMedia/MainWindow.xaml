<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoMedia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:models="using:NeoMedia.Models"
    Title="NeoMedia">

    <Grid x:Name="RootGrid" Background="Black" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.Resources>
            <!-- Boutons du lecteur : transparents, l'icône seule -->
            <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre -->
        <Grid x:Name="AppTitleBar" Padding="14,0,0,0" ColumnSpacing="10" Background="#FF101010">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="Neo" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run Text="Media" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock x:Name="TitleMediaText" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,140,0" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="#B0FFFFFF" />
        </Grid>

        <!-- Scène : vidéo et tout ce qui s'affiche par-dessus -->
        <Grid x:Name="Stage" Grid.Row="1" Background="Black" PointerMoved="Stage_PointerMoved" PointerWheelChanged="Stage_PointerWheelChanged">
            <vlc:VideoView x:Name="VideoView" Initialized="VideoView_Initialized" />

            <!-- Zone cliquable de la vidéo (un clic : pause, double-clic : plein écran) -->
            <Grid x:Name="ClickLayer" Background="Transparent" Tapped="ClickLayer_Tapped" DoubleTapped="ClickLayer_DoubleTapped"
                  RightTapped="ClickLayer_RightTapped" />

            <!-- Rien en lecture -->
            <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="520">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="88" Height="88" />
                <TextBlock Text="Glissez une vidéo, une musique ou un dossier ici" HorizontalAlignment="Center" TextAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Ouvrir des fichiers…" Style="{StaticResource AccentButtonStyle}" Click="OpenFiles_Click" />
                    <Button Content="Ouvrir un dossier…" Click="OpenFolder_Click" />
                    <Button Content="Ouvrir un lien…" Click="OpenUrl_Click" />
                </StackPanel>
                <StackPanel x:Name="RecentPanel" Spacing="2" Margin="0,12,0,0">
                    <TextBlock Text="Récents" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#99FFFFFF" Margin="6,0,0,4" />
                    <ItemsRepeater x:Name="RecentList">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <HyperlinkButton Click="RecentLink_Click" Tag="{x:Bind}" Padding="6,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>

            <!-- Musique : pochette et titre à la place de l'image -->
            <StackPanel x:Name="AudioPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        IsHitTestVisible="False" Margin="0,0,0,90">
                <Border Width="240" Height="240" CornerRadius="12" Background="#FF1C1C1C">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="96" Foreground="#55FFFFFF" />
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <TextBlock x:Name="AudioTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                <TextBlock x:Name="AudioArtist" HorizontalAlignment="Center" Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="480" />
            </StackPanel>

            <!-- Messages -->
            <StackPanel VerticalAlignment="Top" Margin="16" Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
                <InfoBar x:Name="ResumeBar" Severity="Informational" IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button Content="Reprendre depuis le début" Click="RestartFromBeginning_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" />
            </StackPanel>

            <!-- Affichage furtif (volume, avance rapide…) -->
            <Border x:Name="Osd" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"
                    Padding="14,8" CornerRadius="8" Background="#B0000000" IsHitTestVisible="False">
                <TextBlock x:Name="OsdText" FontSize="20" FontWeight="SemiBold" Foreground="White" />
            </Border>

            <!-- Commandes -->
            <Grid x:Name="ControlsPanel" VerticalAlignment="Bottom" Padding="16,28,16,10" RowSpacing="2"
                  PointerEntered="ControlsPanel_PointerEntered" PointerExited="ControlsPanel_PointerExited">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#D9000000" Offset="0.55" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeText" Text="0:00" VerticalAlignment="Center" Foreground="White" FontSize="13" MinWidth="44" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.1" IsThumbToolTipEnabled="False"
                            ValueChanged="SeekSlider_ValueChanged" IsEnabled="False" />
                    <TextBlock x:Name="LengthText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" Foreground="White" FontSize="13" MinWidth="44" TextAlignment="Right" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource PlayerButton}" Click="Previous_Click" ToolTipService.ToolTip="Précédent (P)">
                            <FontIcon Glyph="&#xE892;" FontSize="16" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerButton}" Click="PlayPause_Click" ToolTipService.ToolTip="Lecture / pause (Espace)" Padding="12,8">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="22" />
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTipService.ToolTip="Suivant (N)">
                            <FontIcon Glyph="&#xE893;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="Stop_Click" ToolTipService.ToolTip="Arrêter">
                            <FontIcon Glyph="&#xE71A;" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="12,0,0,0">
                        <Button x:Name="MuteButton" Style="{StaticResource PlayerButton}" Click="Mute_Click" ToolTipService.ToolTip="Couper le son (M)">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="150" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" ToolTipService.ToolTip="Volume (↑ ↓, molette)" />
                        <TextBlock x:Name="VolumeText" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12" Margin="8,0,0,0" MinWidth="36" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="SpeedButton" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Vitesse de lecture ([ et ])">
                            <TextBlock x:Name="SpeedText" Text="1×" FontSize="13" FontWeight="SemiBold" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="SpeedMenu" Placement="Top" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="AudioButton" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Piste audio">
                            <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="AudioMenu" Placement="Top" Opening="AudioMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="SubtitleButton" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Sous-titres">
                            <FontIcon Glyph="&#xED1E;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="SubtitleMenu" Placement="Top" Opening="SubtitleMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource PlayerButton}" Click="Repeat_Click">
                            <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="PlaylistToggle_Click" ToolTipService.ToolTip="Liste de lecture (L)">
                            <FontIcon Glyph="&#xE90B;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Plus">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="MoreMenu" Placement="Top" Opening="MoreMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource PlayerButton}" Click="Fullscreen_Click" ToolTipService.ToolTip="Plein écran (F, double-clic)">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Liste de lecture -->
            <Grid x:Name="PlaylistPanel" Visibility="Collapsed" Width="340" HorizontalAlignment="Right" Background="#F01A1A1A"
                  BorderThickness="1,0,0,0" BorderBrush="#33FFFFFF" Padding="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,4,8,8" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Liste de lecture" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="PlaylistCount" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#99FFFFFF" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PlayerButton}" Click="PlaylistAdd_Click" ToolTipService.ToolTip="Ajouter des fichiers">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PlayerButton}" Click="PlaylistClear_Click" ToolTipService.ToolTip="Vider la liste">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource PlayerButton}" Click="PlaylistToggle_Click" ToolTipService.ToolTip="Fermer">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
                <ListView x:Name="PlaylistView" Grid.Row="1" SelectionMode="Extended" CanReorderItems="True" AllowDrop="True"
                          IsDoubleTapEnabled="True" DoubleTapped="PlaylistView_DoubleTapped" KeyDown="PlaylistView_KeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaylistItem">
                            <Grid ColumnSpacing="10" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Duration, Mode=OneWay}" Foreground="#99FFFFFF" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
