<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoSuite.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NeoSuite">

    <Grid x:Name="RootGrid" Padding="6">
        <Grid.Resources>
            <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </Grid.Resources>

        <StackPanel Spacing="2">
            <Grid Padding="10,10,10,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="36" Height="36" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                        <Run Text="Neo" Foreground="{StaticResource NeoAccentBrush}" /><Run Text="Suite" />
                    </TextBlock>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <MenuFlyoutSeparator Margin="-6,0" />

            <Button Style="{StaticResource MenuButtonStyle}" Click="Open_Click" AutomationProperties.Name="Ouvrir NeoSuite">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                    <TextBlock Grid.Column="1" Text="Ouvrir NeoSuite" FontWeight="SemiBold" />
                    <TextBlock x:Name="ShortcutText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}" Click="Settings_Click" AutomationProperties.Name="Paramètres">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Grid.Column="1" Text="Paramètres" />
                </Grid>
            </Button>

            <MenuFlyoutSeparator Margin="-6,0" />

            <Button Style="{StaticResource MenuButtonStyle}" Click="Quit_Click" AutomationProperties.Name="Quitter NeoSuite">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    <TextBlock Grid.Column="1" Text="Quitter NeoSuite" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Window>
