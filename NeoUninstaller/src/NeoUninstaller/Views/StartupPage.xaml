<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoUninstaller.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NeoUninstaller.Models">

    <Grid Padding="36,24,36,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Démarrage de Windows" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Rechercher un programme au démarrage" QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Rechercher" />
            <Button Grid.Column="2" Click="RefreshButton_Click" AutomationProperties.Name="Actualiser">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Actualiser" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False" />

        <ProgressRing x:Name="LoadingRing" Grid.Row="3" IsActive="True" Width="40" Height="40" VerticalAlignment="Center" />

        <ListView x:Name="ItemList" Grid.Row="3" SelectionMode="None" Padding="0,0,0,24" Visibility="Collapsed">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StartupItem">
                    <Grid ColumnSpacing="14" Tag="{x:Bind}" ContextRequested="Item_ContextRequested" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32">
                            <FontIcon Glyph="&#xE7E8;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Visibility="{x:Bind HasNoIcon, Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Command}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Command}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind PublisherText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Tag="{x:Bind}" Toggled="Toggle_Toggled"
                                      OnContent="Activé" OffContent="Désactivé" MinWidth="130" AutomationProperties.Name="{x:Bind DisplayName}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
