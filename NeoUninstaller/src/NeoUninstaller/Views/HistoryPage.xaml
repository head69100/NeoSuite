<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoUninstaller.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,24,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Historique et sauvegardes" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Chaque nettoyage est sauvegardé : « Tout annuler » remet les fichiers à leur place depuis la Corbeille et réimporte les clés de registre (7 jours maximum pour la Corbeille)."
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="ResultBar" Grid.Row="1" IsOpen="False" />

        <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE81C;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Aucun nettoyage pour le moment" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="ReportsPanel" Spacing="8" />
        </ScrollViewer>
    </Grid>
</Page>
