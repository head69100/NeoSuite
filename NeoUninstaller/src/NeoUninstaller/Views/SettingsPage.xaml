<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoUninstaller.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="6">
            <TextBlock Text="Paramètres" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <TextBlock Text="Apparence" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" />
                    <TextBlock Grid.Column="1" Text="Thème" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" MinWidth="160" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Système" />
                        <ComboBoxItem Content="Clair" />
                        <ComboBoxItem Content="Sombre" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Désinstallation" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE777;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Créer un point de restauration" />
                        <TextBlock Text="Avant chaque désinstallation (en mode administrateur)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RestorePointToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Toggle_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Chercher les restes automatiquement" />
                        <TextBlock Text="Dès que le désinstalleur du programme a terminé" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoScanToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Toggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Text="Surveillance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Prévenir quand un programme s'ajoute au démarrage" />
                        <TextBlock Text="Clés Run, dossiers Démarrage et tâches planifiées, tant que NeoUninstaller est ouvert" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="WatchToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Toggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Text="À propos" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="40" Height="40" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NeoUninstaller" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
