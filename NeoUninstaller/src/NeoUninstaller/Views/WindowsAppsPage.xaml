<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoUninstaller.Views.WindowsAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NeoUninstaller.Models">

    <Grid Padding="36,24,36,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Applis Windows" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Applis préinstallées et du Microsoft Store. Une appli supprimée peut être réinstallée à tout moment depuis le Microsoft Store."
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Rechercher une appli" QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Rechercher" />
            <ComboBox x:Name="FilterCombo" Grid.Column="1" MinWidth="210" SelectedIndex="0" SelectionChanged="FilterCombo_SelectionChanged"
                      AutomationProperties.Name="Filtrer">
                <ComboBoxItem Content="Toutes les applis" />
                <ComboBoxItem Content="Souvent inutiles" />
                <ComboBoxItem Content="Applis de Windows" />
                <ComboBoxItem Content="Autres éditeurs" />
            </ComboBox>
            <HyperlinkButton Grid.Column="3" Content="Cocher les applis souvent inutiles" Click="CheckBloat_Click" />
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False" />

        <ProgressRing x:Name="LoadingRing" Grid.Row="3" IsActive="True" Width="40" Height="40" VerticalAlignment="Center" />

        <ListView x:Name="AppList" Grid.Row="3" SelectionMode="None" Padding="0,0,0,12" Visibility="Collapsed">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:WindowsApp">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="{x:Bind DisplayName}" />
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Image Source="{x:Bind Logo}" Width="26" Height="26" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind DetailsText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="3" Padding="8,2" CornerRadius="8" VerticalAlignment="Center" Visibility="{x:Bind HasTag}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind TagText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Barre d'action -->
        <Grid Grid.Row="4" Padding="0,0,0,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
            <CheckBox x:Name="AllUsersCheck" Grid.Column="1" Content="Pour tous les utilisateurs du PC" VerticalAlignment="Center"
                      ToolTipService.ToolTip="Nécessite les droits administrateur" />
            <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="RemoveButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Supprimer la sélection">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Supprimer la sélection" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
