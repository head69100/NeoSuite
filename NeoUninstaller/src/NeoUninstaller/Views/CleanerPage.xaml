<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoUninstaller.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NeoUninstaller.Models">

    <Grid Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Nettoyage" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="Libérez de l'espace et retirez les entrées mortes du registre. Analysez d'abord : rien n'est supprimé sans votre accord." />
        </StackPanel>

        <SelectorBar x:Name="TabBar" Grid.Row="1" Margin="-12,0,0,0" SelectionChanged="TabBar_SelectionChanged">
            <SelectorBarItem Text="Fichiers inutiles" IsSelected="True" Tag="Files">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Registre et raccourcis" Tag="Registry">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE74C;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False" />

        <!-- Fichiers inutiles -->
        <ListView x:Name="JunkList" Grid.Row="3" SelectionMode="None" Padding="0,0,0,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:JunkCategory">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanClean}" MinWidth="0"
                                  AutomationProperties.Name="{x:Bind Name}" />
                        <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind Name}" /><Run Text="  ·  " Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><Run Text="{x:Bind Group}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind DetailsText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Registre et raccourcis -->
        <Grid x:Name="RegistryPanel" Grid.Row="3" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="RegistryHint" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="Recherche uniquement les entrées qui pointent vers un fichier disparu. Chaque suppression est sauvegardée (page Historique)." />
            <ListView x:Name="IssueList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Leftover">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanDelete}" MinWidth="0"
                                      AutomationProperties.Name="{x:Bind DisplayPath}" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayPath}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayPath}" />
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="4" Padding="0,8,0,20" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="TotalText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="AnalyzeButton" Grid.Column="1" Click="AnalyzeButton_Click" AutomationProperties.Name="Analyser">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock Text="Analyser" />
                </StackPanel>
            </Button>
            <Button x:Name="CleanButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="CleanButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Nettoyer">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Name="CleanText" Text="Nettoyer" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
