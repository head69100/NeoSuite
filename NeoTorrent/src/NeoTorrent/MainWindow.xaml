<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoTorrent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NeoTorrent">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de titre -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="Neo" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run Text="Torrent" FontWeight="SemiBold" />
            </TextBlock>
        </Grid>

        <!-- Barre d'outils -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left" Margin="8,0,8,0">
            <AppBarButton x:Name="AddTorrentButton" Label="Ouvrir un torrent" Click="AddTorrentButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="AddMagnetButton" Label="Ajouter un lien magnet" Click="AddMagnetButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE71B;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="StartButton" Label="Démarrer" Click="StartButton_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="PauseButton" Label="Mettre en pause" Click="PauseButton_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE769;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RemoveButton" Label="Supprimer" Click="RemoveButton_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Dossier de téléchargement" Click="ChooseDownloadDirButton_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Paramètres" Click="SettingsButton_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="2" Padding="16,0,16,0">
            <ListView x:Name="TorrentList" SelectionMode="Single" SelectionChanged="TorrentList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="56" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" VerticalAlignment="Center" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding SpeedText}" VerticalAlignment="Center" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding EtaText}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="Aucun torrent. Ouvrez un fichier .torrent ou ajoutez un lien magnet." 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Style="{StaticResource SecondaryTextStyle}" />
        </Grid>

        <Grid x:Name="StatusBar" Grid.Row="3" Padding="20,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Text="Prêt" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
