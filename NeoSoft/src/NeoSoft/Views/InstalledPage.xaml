<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoSoft.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NeoSoft.Models">

    <Grid Padding="36,24,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mises à jour" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Center" Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Rechercher les mises à jour" />
                </StackPanel>
            </Button>
            <Button x:Name="UpdateAllButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="UpdateAllButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                    <TextBlock x:Name="UpdateAllText" Text="Tout mettre à jour" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="RefreshProgress" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="ResultBar" IsOpen="False" />
        </StackPanel>

        <ListView x:Name="InstalledList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SoftwareItem">
                    <Border Padding="16,12" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32">
                                <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Width="24" Height="24" Source="{x:Bind IconUrl}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind VersionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" Visibility="{x:Bind IsBusy, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Annuler" VerticalAlignment="Center" Visibility="{x:Bind IsBusy, Mode=OneWay}"
                                    Tag="{x:Bind}" Click="CancelButton_Click" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind IsIdle, Mode=OneWay}">
                                <Button Content="Mettre à jour" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind HasUpdate, Mode=OneWay}"
                                        Tag="{x:Bind}" Click="UpdateButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyPanel" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="12">
            <TextBlock Text="Toutes les mises à jour sont installées." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
            <Button Content="Parcourir le catalogue" HorizontalAlignment="Center" Click="BrowseButton_Click" />
        </StackPanel>
    </Grid>
</Page>
