<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoSoft.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NeoSoft.Models"
    xmlns:services="using:NeoSoft.Services">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="8">
            <TextBlock Text="Téléchargements" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Les logiciels s'installent l'un après l'autre. Windows peut demander une confirmation pour ceux qui s'installent pour tous les utilisateurs." />

            <Grid>
                <TextBlock Text="En cours" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="CancelAllButton" HorizontalAlignment="Right" Click="CancelAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                        <TextBlock Text="Tout annuler" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="NoPendingText" Text="Aucune installation en cours." Style="{StaticResource SecondaryTextStyle}" />
            <ItemsRepeater x:Name="PendingList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SoftwareItem">
                        <Border Padding="16,12" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="2" Content="Annuler" VerticalAlignment="Center" Tag="{x:Bind}" Click="CancelButton_Click" />
                                <Image Width="24" Height="24" Source="{x:Bind IconUrl}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" HorizontalAlignment="Right"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Grid Margin="0,20,0,0">
                <TextBlock Text="Historique" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="ClearHistoryButton" HorizontalAlignment="Right" Click="ClearHistoryButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock Text="Vider l'historique" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="NoHistoryText" Text="Rien pour l'instant." Style="{StaticResource SecondaryTextStyle}" />
            <ItemsRepeater x:Name="HistoryList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="services:ActivityEntry">
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="14" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Message}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
