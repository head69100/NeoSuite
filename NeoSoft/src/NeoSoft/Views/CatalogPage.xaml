<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoSoft.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NeoSoft.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="36,24,36,8" Spacing="12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Catalogue" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="Chaque logiciel est téléchargé depuis le site officiel de son éditeur, vérifié, puis installé automatiquement. Sans publicité ni barre d'outils." />
                </StackPanel>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center"
                                PlaceholderText="Rechercher un logiciel" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
            </Grid>

            <InfoBar x:Name="WingetMissing" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="winget est introuvable"
                     Message="NeoSoft s'appuie sur le gestionnaire de paquets de Windows. Installez « Programme d'installation d'application » depuis le Microsoft Store, puis relancez NeoSoft." />

            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                <SelectorBar x:Name="CategoryBar" SelectionChanged="CategoryBar_SelectionChanged" />
            </ScrollViewer>
        </StackPanel>

        <GridView x:Name="SoftwareGrid" Grid.Row="1" Padding="32,4,32,24" SelectionMode="None" IsItemClickEnabled="False">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:SoftwareItem">
                    <Border Width="300" Height="172" Padding="16" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40">
                                    <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Initial}" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Width="32" Height="32" Source="{x:Bind IconUrl}" Visibility="{x:Bind ShowIcon}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Publisher}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" MinWidth="0" Padding="0" VerticalAlignment="Top"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                          Visibility="{x:Bind CanSelect, Mode=OneWay}"
                                          ToolTipService.ToolTip="Ajouter à la sélection" />
                            </Grid>

                            <!-- Avertissement pour les paquets winget hors catalogue, puis description -->
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock Visibility="{x:Bind IsExternal}" Text="&#x26A0; Non vérifié par NeoSuite"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Action ou progression -->
                            <Grid Grid.Row="2">
                                <Grid Visibility="{x:Bind IsIdle, Mode=OneWay}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind VersionText, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button Grid.Column="1" MinWidth="120" Content="{x:Bind ActionText, Mode=OneWay}" IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="ActionButton_Click" />
                                </Grid>
                                <Grid Visibility="{x:Bind IsBusy, Mode=OneWay}" ColumnSpacing="10" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Annuler" Tag="{x:Bind}" Click="CancelButton_Click" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="NoResultText" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,48,0,0"
                   Text="Aucun logiciel ne correspond à votre recherche." Style="{StaticResource SecondaryTextStyle}" />

        <!-- Barre de sélection -->
        <Border x:Name="SelectionBar" Grid.Row="2" Visibility="Collapsed" Padding="36,12" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button Grid.Column="1" Content="Tout désélectionner" Click="ClearSelection_Click" />
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="InstallSelection_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Installer la sélection" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
